# UART0 / USB serial console
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200

# Keep baseline logging modest so the (now low-rate) console output stays readable.
CONFIG_LOG_DEFAULT_LEVEL_WARN=y

# BT / NimBLE -- BLE peripheral/GATT server only. No classic BT, no
# Bluedroid (NimBLE is used instead -- lighter, and all that's needed for
# a GATT peripheral). Option names verified against this exact ESP-IDF
# checkout's Kconfig (components/bt/controller/esp32/Kconfig.in,
# components/bt/host/nimble/Kconfig.in) rather than assumed from memory.
CONFIG_BT_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=n
CONFIG_BTDM_CTRL_MODE_BTDM=n
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y

# Peripheral-only: this firmware never scans/connects as a BLE central and
# never broadcasts/observes: it only ever advertises, accepts one incoming
# connection, and serves one GATT service. Trimming the other roles keeps
# flash usage down.
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
